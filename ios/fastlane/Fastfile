# Foodie — local deploy pipeline (run from ios/ on your Mac).
#
#   bundle exec fastlane setup      # one-time: writes your Team ID + Bundle ID into the project
#   bundle exec fastlane preflight  # check that your setup is complete before you build
#   bundle exec fastlane friends    # build + ship to the external TestFlight group (shareable link)
#   bundle exec fastlane beta       # build + upload to TestFlight (internal testers only, fast)
#   bundle exec fastlane release    # build + upload + submit for App Store review (auto-release on approval)
#   bundle exec fastlane submit     # submit an already-uploaded build (no rebuild)
#
# Config comes from ios/fastlane/.env (see .env.example).

default_platform(:ios)

PROJECT = "Foodie.xcodeproj"
SCHEME  = "Foodie"

# The external TestFlight group your friends join via the public link.
TESTFLIGHT_GROUP = (ENV["TESTFLIGHT_GROUP"] || "Friends").freeze

def asc_api_key
  # CI passes the key as a base64 secret (ASC_KEY_CONTENT); locally we read the
  # .p8 file (ASC_KEY_PATH). Support both.
  if ENV["ASC_KEY_CONTENT"] && !ENV["ASC_KEY_CONTENT"].empty?
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )
  else
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      duration: 1200,
      in_house: false
    )
  end
end

MATCH_PROFILE = "match AppStore #{ENV['APP_IDENTIFIER']}".freeze

# Build for CI using match-provided manual signing (no automatic signing on runners).
def build_the_app_ci
  build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    clean: true,
    output_directory: "build",
    output_name: "Foodie.ipa",
    export_options: {
      method: "app-store",
      signingStyle: "manual",
      teamID: ENV.fetch("DEV_TEAM_ID"),
      provisioningProfiles: {
        ENV.fetch("APP_IDENTIFIER") => MATCH_PROFILE
      }
    }
  )
end

# Point the target at the match distribution profile (manual signing) for CI.
def apply_match_signing
  update_code_signing_settings(
    path: PROJECT,
    use_automatic_signing: false,
    team_id: ENV.fetch("DEV_TEAM_ID"),
    bundle_identifier: ENV.fetch("APP_IDENTIFIER"),
    code_sign_identity: "Apple Distribution",
    profile_name: MATCH_PROFILE,
    targets: [SCHEME]
  )
end

def build_the_app
  build_app(
    project: PROJECT,
    scheme: SCHEME,
    configuration: "Release",
    export_method: "app-store",
    clean: true,
    output_directory: "build",
    output_name: "Foodie.ipa",
    xcargs: "-allowProvisioningUpdates",
    export_xcargs: "-allowProvisioningUpdates",
    export_options: {
      method: "app-store",
      signingStyle: "automatic",
      teamID: ENV["DEV_TEAM_ID"]
    }
  )
end

platform :ios do
  # ---- One-time project setup ------------------------------------------------
  desc "Write your Team ID + Bundle ID into the Xcode project (one time)"
  lane :setup do
    team   = ENV.fetch("DEV_TEAM_ID")
    bundle = ENV.fetch("APP_IDENTIFIER")

    update_code_signing_settings(
      path: PROJECT,
      use_automatic_signing: true,
      team_id: team,
      targets: [SCHEME]
    )

    # Replace the placeholder bundle id everywhere in the project file.
    # (sed -i '' is the macOS form.)
    sh("sed -i '' 's/com\\.example\\.Foodie/#{bundle}/g' ../#{PROJECT}/project.pbxproj")

    UI.success("Project set to team #{team}, bundle id #{bundle}.")
    UI.message("Commit the change: git add -A && git commit -m 'Configure signing'")
  end

  # ---- Preflight -------------------------------------------------------------
  desc "Check that your Apple setup is complete before you try to build"
  lane :preflight do
    missing = %w[APP_IDENTIFIER DEV_TEAM_ID ASC_KEY_ID ASC_ISSUER_ID].reject do |k|
      ENV[k] && !ENV[k].empty?
    end
    unless missing.empty?
      UI.user_error!("Missing in ios/fastlane/.env: #{missing.join(', ')}. Copy .env.example -> .env and fill it in.")
    end

    key_path = ENV["ASC_KEY_PATH"]
    if (ENV["ASC_KEY_CONTENT"].nil? || ENV["ASC_KEY_CONTENT"].empty?) &&
       (key_path.nil? || !File.exist?(File.expand_path(key_path, "..")))
      UI.user_error!("ASC_KEY_PATH points at a missing .p8 (#{key_path.inspect}). Download the key from App Store Connect into ios/fastlane/private/.")
    end
    UI.success("✅ .env looks complete.")

    pbxproj = File.read("../#{PROJECT}/project.pbxproj")
    if pbxproj.include?("com.example.Foodie")
      UI.user_error!("The project still uses the placeholder bundle id. Run: bundle exec fastlane setup")
    end
    unless pbxproj.include?(ENV.fetch("APP_IDENTIFIER"))
      UI.user_error!("The project's bundle id doesn't match APP_IDENTIFIER (#{ENV.fetch('APP_IDENTIFIER')}). Run: bundle exec fastlane setup")
    end
    UI.success("✅ Xcode project is set to #{ENV.fetch('APP_IDENTIFIER')}.")

    # A successful call proves the API key works AND the app record exists.
    api_key = asc_api_key
    begin
      build = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: ENV.fetch("APP_IDENTIFIER"),
        initial_build_number: 0
      )
      UI.success("✅ App Store Connect key works. App record found. Latest TestFlight build: #{build}.")
    rescue StandardError => e
      UI.user_error!("Couldn't reach the app in App Store Connect: #{e.message}\n" \
                     "Most likely the app record doesn't exist yet — create it at " \
                     "https://appstoreconnect.apple.com/apps with bundle id #{ENV.fetch('APP_IDENTIFIER')}.")
    end

    UI.success("Preflight passed. You're clear to run: bundle exec fastlane friends")
  end

  # ---- TestFlight ------------------------------------------------------------
  desc "Build and ship to the external TestFlight group (the shareable-link path)"
  lane :friends do
    api_key = asc_api_key
    bump_build(api_key)
    build_the_app
    ship_to_external(api_key)
  end

  desc "Distribute an ALREADY-uploaded build to the external group (no rebuild)"
  lane :friends_distribute do
    ship_to_external(asc_api_key, distribute_only: true)
  end

  desc "Build and upload a new build to TestFlight (internal testers only)"
  lane :beta do
    api_key = asc_api_key
    bump_build(api_key)
    build_the_app
    upload_to_testflight(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      skip_waiting_for_build_processing: true
    )
    UI.success("Uploaded to TestFlight. It'll appear after Apple finishes processing (~5-15 min).")
  end

  # ---- App Store -------------------------------------------------------------
  desc "Build, upload, and submit for App Store review"
  lane :release do
    api_key = asc_api_key
    bump_build(api_key)
    build_the_app
    deliver_and_submit(api_key)
  end

  desc "Submit an already-uploaded build for review (no rebuild)"
  lane :submit do
    api_key = asc_api_key
    deliver_and_submit(api_key, skip_binary: true)
  end

  # ---- One-time match setup (run locally once) -------------------------------
  desc "One-time: create/store the distribution cert + profile in the match repo"
  lane :certificates do
    api_key = asc_api_key
    match(
      type: "appstore",
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      api_key: api_key,
      readonly: false # allow creating the cert/profile the first time
    )
    UI.success("Distribution cert + profile stored in your match repo. CI can now use them.")
  end

  # ---- CI lanes (called by GitHub Actions) -----------------------------------
  desc "CI: build + upload to TestFlight using match signing"
  lane :ci_beta do
    api_key = asc_api_key
    setup_ci # ephemeral keychain on the runner
    match(type: "appstore", app_identifier: ENV.fetch("APP_IDENTIFIER"),
          api_key: api_key, readonly: true)
    apply_match_signing
    bump_build(api_key)
    build_the_app_ci
    upload_to_testflight(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      skip_waiting_for_build_processing: true
    )
  end

  desc "CI: build + ship to the external TestFlight group using match signing"
  lane :ci_friends do
    api_key = asc_api_key
    setup_ci
    match(type: "appstore", app_identifier: ENV.fetch("APP_IDENTIFIER"),
          api_key: api_key, readonly: true)
    apply_match_signing
    bump_build(api_key)
    build_the_app_ci
    ship_to_external(api_key)
  end

  desc "CI: build + upload + submit for App Store review using match signing"
  lane :ci_release do
    api_key = asc_api_key
    setup_ci
    match(type: "appstore", app_identifier: ENV.fetch("APP_IDENTIFIER"),
          api_key: api_key, readonly: true)
    apply_match_signing
    bump_build(api_key)
    build_the_app_ci
    deliver_and_submit(api_key)
  end
end

# ---- Helpers -----------------------------------------------------------------

# Set the next build number = (latest on TestFlight) + 1. Handles the very first
# build (no TestFlight builds yet) by starting at 1.
def bump_build(api_key)
  latest = begin
    latest_testflight_build_number(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      initial_build_number: 0
    )
  rescue StandardError
    0
  end
  increment_build_number(xcodeproj: PROJECT, build_number: latest + 1)
end

# Upload (or re-use) a build and distribute it to the EXTERNAL tester group —
# the one that can have a public, shareable TestFlight link.
#
# External distribution requires a fully processed build, so unlike the internal
# `beta` lane we have to wait for Apple's processing (~5-15 min) before handing
# the build to the group.
#
# The first external build of each version goes through Apple's Beta App Review
# (usually well under 24h). Later builds of the same version normally skip it.
def ship_to_external(api_key, distribute_only: false)
  contact = ENV["BETA_CONTACT_NAME"].to_s.strip.split(" ", 2)
  review_info = if ENV["BETA_CONTACT_EMAIL"].to_s.empty? || contact.length < 2 || ENV["BETA_CONTACT_PHONE"].to_s.empty?
    UI.important("BETA_CONTACT_NAME / _EMAIL / _PHONE not all set in .env — skipping the Beta App Review " \
                 "contact info. If review info is missing, fill it in once in App Store Connect " \
                 "(TestFlight -> Test Information) and it sticks for future builds.")
    nil
  else
    {
      contact_email: ENV.fetch("BETA_CONTACT_EMAIL"),
      contact_first_name: contact[0],
      contact_last_name: contact[1],
      contact_phone: ENV.fetch("BETA_CONTACT_PHONE"),
      demo_account_required: false,
      notes: "All data is stored locally on the device. No account, no login, no network calls."
    }
  end

  options = {
    api_key: api_key,
    app_identifier: ENV.fetch("APP_IDENTIFIER"),
    distribute_external: true,
    groups: [TESTFLIGHT_GROUP],
    notify_external_testers: true,
    # "What to Test" — shown to testers in the TestFlight app.
    changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Log a few meals, set your calorie goal, and tell me what feels clunky.",
    beta_app_description: ENV["BETA_APP_DESCRIPTION"] ||
      "Foodie is a simple calorie + macro tracker. Everything is stored on your device — no account, no sign-in.",
    demo_account_required: false,
    uses_non_exempt_encryption: false
  }
  options[:beta_app_feedback_email] = ENV["BETA_FEEDBACK_EMAIL"] unless ENV["BETA_FEEDBACK_EMAIL"].to_s.empty?
  options[:beta_app_review_info] = review_info if review_info

  if distribute_only
    options[:distribute_only] = true
  else
    options[:skip_waiting_for_build_processing] = false
    options[:wait_processing_interval] = 30
  end

  upload_to_testflight(options)

  UI.success("Build is live for the '#{TESTFLIGHT_GROUP}' group.")
  UI.message("If this is the group's first build it goes to Beta App Review first (usually <24h).")
  UI.message("Grab the shareable link: App Store Connect -> TestFlight -> #{TESTFLIGHT_GROUP} -> Public Link.")
end

def deliver_and_submit(api_key, skip_binary: false)
  upload_to_app_store(
    api_key: api_key,
    app_identifier: ENV.fetch("APP_IDENTIFIER"),
    skip_binary_upload: skip_binary,
    # Metadata + screenshots are managed in the App Store Connect web UI for the
    # first launch. Flip these to false later if you want fastlane to manage them.
    skip_metadata: true,
    skip_screenshots: true,
    submit_for_review: true,
    automatic_release_after_approval: true,
    precheck_include_in_app_purchases: false,
    force: true, # don't open the HTML preview / prompt
    submission_information: {
      export_compliance_uses_encryption: false, # only standard HTTPS/none -> exempt
      add_id_info_uses_idfa: false
    }
  )
  UI.success("Submitted for review. It'll auto-release once Apple approves.")
end
