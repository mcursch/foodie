# Copy this file to `.env` (in ios/fastlane/) and fill in your values.
# `.env` is gitignored — it and your .p8 key must NEVER be committed.

# Your app's bundle identifier. Must be one you own in the Developer portal,
# and must match the app record in App Store Connect.
APP_IDENTIFIER=com.yourname.Foodie

# Apple Developer portal Team ID (10 chars). Find it at:
# https://developer.apple.com/account  ->  Membership details.
DEV_TEAM_ID=ABCDE12345

# App Store Connect API key (Users and Access -> Integrations -> App Store Connect API).
# Create a key with the "App Manager" role, then download the .p8 ONCE.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Path to the downloaded .p8, relative to the ios/ directory.
# Put the file in ios/fastlane/private/ (gitignored).
ASC_KEY_PATH=./fastlane/private/AuthKey_XXXXXXXXXX.p8

# ---- Only needed for CI / GitHub Actions (Fastlane match) -------------------
# A PRIVATE git repo that stores your encrypted signing cert + profile.
MATCH_GIT_URL=https://github.com/yourname/foodie-certs.git
# A strong passphrase used to encrypt the contents of that repo. Save it safely.
MATCH_PASSWORD=choose-a-strong-passphrase
# CI only: the .p8 as a base64 string instead of a file path. Generate with:
#   base64 -i ios/fastlane/private/AuthKey_XXXXXXXXXX.p8 | pbcopy
# Leave BLANK locally (the file path above is used instead).
# ASC_KEY_CONTENT=
